# Server — in production set HOST=0.0.0.0 (or leave unset) and PORT as given by the platform
PORT=3000
HOST=localhost

# Database — local:  mongodb://localhost:27017/class
# production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/class
